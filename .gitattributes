# Antigravity parses these files; keep them LF on every platform.
*.md    text eol=lf
*.py    text eol=lf
*.json  text eol=lf
*.js    text eol=lf
*.sh    text eol=lf
*.ps1   text eol=lf
*.tsv   text eol=lf
*.yml   text eol=lf
*.svg   text eol=lf
# No extension, so no rule above covers them: a clone with core.autocrlf=true gave them CRLF,
# and release_check.py then reported them as changed.
.gitattributes  text eol=lf
.gitignore      text eol=lf
LICENSE         text eol=lf
# The installers: cmd needs CRLF, and bash on macOS and Linux needs LF (*.sh is above).
*.cmd      text eol=crlf
*.command  text eol=lf
# Written by scripts/build_dist.py; GitHub folds it in diffs.
dist/**    linguist-generated=true
